# Copiez ce fichier en `.env` puis adaptez-le. Ne versionnez jamais `.env`.

# --- LLM --------------------------------------------------------------------------------
# simulated : agents scriptés, aucune clé nécessaire (démo, tests).
# gateway   : vrais modèles via le proxy LiteLLM (docker compose --profile llm up).
OMNIFORGE_LLM_MODE=simulated

# Clés des fournisseurs : lues uniquement par le proxy LiteLLM.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Clé d'accès au proxy (choisissez une valeur longue et aléatoire).
LITELLM_MASTER_KEY=
# Serveur Ollama pour le palier « routine » (profil compose `local-models`).
OLLAMA_API_BASE=http://ollama:11434

# --- API --------------------------------------------------------------------------------
# Clé statique exigée des clients de l'API. Vide = API ouverte (poste local uniquement).
OMNIFORGE_API_KEY=
# Origines navigateur autorisées (CORS), séparées par des virgules.
OMNIFORGE_CORS_ORIGINS=http://localhost:3000
# Adresse de l'API vue par le navigateur.
NEXT_PUBLIC_API_URL=http://localhost:8080
# Latence artificielle des agents simulés, pour suivre la démo à l'œil (ms).
OMNIFORGE_SIM_DELAY_MS=400

# --- Sandbox ----------------------------------------------------------------------------
# Groupe propriétaire du socket Docker : stat -c '%g' /var/run/docker.sock
DOCKER_GID=
