# syntax=docker/dockerfile:1
# OmniForge API — all-in-one DEMO image, for container platforms that cannot give the API
# a Docker daemon (Render, Railway, Fly.io, Cloud Run…). Build context: repository root.
#
#   docker build -f backend/Dockerfile.demo -t omniforge-demo .
#
# Agent commands run inside this very container (local sandbox): there is NO per-run
# isolation. It is meant for the simulated LLM backend, to try the product end to end.
# With real models, use backend/Dockerfile and the Docker sandbox (docker-compose.yml).

FROM rust:1-slim-bookworm AS build
WORKDIR /src/backend
COPY backend/Cargo.toml backend/Cargo.lock ./
COPY backend/src ./src
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/src/backend/target \
    cargo build --release --locked && cp target/release/omniforge /usr/local/bin/omniforge

# Same toolchain as the sandbox image, since the sandbox is this container.
FROM python:3.12-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends git poppler-utils \
    && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir pytest==8.* ruff
COPY --from=build /usr/local/bin/omniforge /usr/local/bin/omniforge

RUN useradd --uid 10001 --user-group --create-home omniforge \
    && mkdir -p /data && chown 10001:10001 /data
USER 10001:10001

ENV OMNIFORGE_DATA_DIR=/data \
    OMNIFORGE_SANDBOX=local \
    OMNIFORGE_LLM_MODE=simulated \
    OMNIFORGE_SIM_DELAY_MS=400 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PORT=8080
EXPOSE 8080
# Container platforms pass the port to listen on in $PORT.
CMD ["sh", "-c", "exec omniforge serve --bind 0.0.0.0:${PORT}"]
