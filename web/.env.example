# Base URL of the OmniForge backend (Rust API), as reachable FROM THE BROWSER.
# Inlined at build time (NEXT_PUBLIC_*): rebuild the app after changing it.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Optional: static API key expected by the backend (OMNIFORGE_API_KEY).
# It is shipped to the browser — use it for demos only; in production put the
# dashboard and the API behind your SSO / API gateway instead.
# NEXT_PUBLIC_API_KEY=
