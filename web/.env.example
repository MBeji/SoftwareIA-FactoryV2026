# Copy to .env.local for local development. NEXT_PUBLIC_* values are inlined into the
# browser bundle at build time: rebuild after changing them.

# Base URL of the OmniForge backend, as reachable FROM THE BROWSER.
# Left unset, the dashboard talks to http://localhost:8080 when it is served from localhost,
# and switches to demo mode (replay of recorded runs) anywhere else — which is what makes a
# backend-less deployment such as Vercel work out of the box.
# NEXT_PUBLIC_API_URL=http://localhost:8080

# Optional: static API key expected by the backend (OMNIFORGE_API_KEY).
# It is shipped to the browser — it keeps strangers off the API, not the dashboard's own
# users. In production put the dashboard and the API behind your SSO / API gateway.
# NEXT_PUBLIC_API_KEY=

# Force demo mode even when a backend URL is set.
# NEXT_PUBLIC_DEMO_MODE=1
